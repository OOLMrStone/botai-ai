# Образец локальных переменных. Скопировать в .env.local и править под себя:
#   cp .env.example .env.local
#
# Режим сборки (local | dev | prod) и мок задают npm-скрипты (см. package.json):
#   npm run dev        - разработка, мок-бэкенд
#   npm run dev:api    - разработка, прокси на реальный бэкенд
#   npm run build:dev  - сборка тестового стенда (как прод + dev-панель)
#   npm run build      - боевая сборка
# Здесь - только то, что зависит от машины.

# Адрес Spring-бэкенда для прокси /api/* (когда мок выключен).
BACKEND_URL=http://localhost:8080

# Для B2B-стенда: BACKEND_URL=http://127.0.0.1:18086
# Необязательная личная проекция разбора; обычному B2B-стенду не нужна.
# Указать абсолютный путь к приватному каталогу с manifest.json и review.expert-review.v2.json.
B2B_PRESENTATION_FIXTURE_DIR=
