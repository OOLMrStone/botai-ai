# Documentation only. init-secrets.py generates unique values into runtime/.env.integration.
COMPOSE_PROJECT_NAME=botai-integration-local
POSTGRES_PASSWORD=generated-private-value
APP_DB_PASSWORD=generated-private-value
OPS_DB_PASSWORD=generated-private-value
GARAGE_RPC_SECRET=generated-32-byte-hex
S3_ACCESS_KEY=generated-GK-prefixed-value
S3_SECRET_KEY=generated-private-value
AI_SERVICE_TOKEN=generated-private-value
AI_CONTEXT=/absolute/path/to/allowed-ai-runtime-export
FRONT_CONTEXT=../botai-front
FRONTEND_BASE_URL=http://127.0.0.1:13000
