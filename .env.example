# ---------------------------------------------------------------------------
# Copy to .env and fill in.  docker compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- application ----------------------------------------------------------
APP_ENV=local                 # local | dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=console        # console | json  (use json in dev/prod)
APP_CORS_ORIGINS=*

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=mock             # openai | mock   <- mock costs nothing, see docs/DEBUG_TOOLKIT.md
LLM_API_KEY=
LLM_BASE_URL=                 # leave empty for api.openai.com; set for any OpenAI-compatible gateway
LLM_MODEL=gpt-5
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4000
LLM_STRUCTURED_MODE=auto      # auto | json_schema | json_object | prompt
LLM_TOKEN_PARAM=auto          # auto | max_tokens | max_completion_tokens
LLM_SUPPORTS_TEMPERATURE=auto # auto | true | false
LLM_CONCURRENCY=8

# --- stage 1 (vision) -----------------------------------------------------
# Only stage 1 sees the photograph. Anything left empty falls back to the
# LLM_* values above, so these matter when the model that reads handwriting
# is not the model that does the reasoning — including when the text provider
# has no vision model at all (DeepSeek, most local setups).
LLM_VISION_PROVIDER=
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# --- provider presets -----------------------------------------------------
# Swapping providers is these four variables. Everything else adapts on its
# own: the client probes token-parameter naming, temperature support and
# structured-output support, then remembers what worked (docs/LLM_LAYER.md).
#
# After editing, `docker compose up -d --force-recreate` — plain `restart`
# keeps the old environment and the change appears to do nothing.
#
# OpenAI — one provider for all three stages, vision included
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=
#   LLM_MODEL=gpt-5
#
# DeepSeek — cheap, strong at maths, and covers all three stages.
# Measured on the task-13 sample: 92s end to end, ~24k tokens, ~1.5 US cents.
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-flash            # -pro reasons harder and costs time
#   LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
#   LLM_STRUCTURED_MODE=json_object        # strict json_schema is rejected
#   LLM_MAX_OUTPUT_TOKENS=32000            # reasoning is drawn from this
#   LLM_VISION_MAX_OUTPUT_TOKENS=8000
#   LLM_VISION_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# The last three lines are not tuning, they are required:
#   * v4 rejects strict json_schema, so `auto` spends a 400 discovering that;
#   * reasoning tokens come out of max_output_tokens, and at 8000 stage 2 ends
#     mid-thought with an empty answer (the error says so and does not retry);
#   * stage 1 is transcription, and thinking about it cost 56s and ~11k tokens
#     for no gain — off, it is 8s. Stages 2-3 keep thinking; that is what
#     finds the mistakes.
#
# These two VISION values are stage 1's profile, not the vision endpoint's.
# With FEATURES={"reconstruct_first": false} stage 2 runs on that endpoint and
# deliberately does NOT inherit them — it keeps the text budget and lets the
# provider's thinking default stand. If that combined read-and-analyse call
# still truncates, raise LLM_MAX_OUTPUT_TOKENS: the error names the cap it hit.
#
# OpenRouter — one key, many models; `:free` variants are heavily
# rate-limited and slow (minutes per stage), fine for smoke tests only.
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=...
#
# Anything OpenAI-compatible (vLLM, Ollama, a corporate gateway)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:11434/v1   # from inside Docker
#   LLM_MODEL=...

# --- cost reporting -------------------------------------------------------
# USD per million tokens, merged over the built-in table in llm/pricing.py.
# The built-ins are UNVERIFIED list prices: check them against your provider
# before trusting a total. A cost reported as source=table is an estimate,
# source=provider is what the provider actually charged.
#   LLM_PRICING={"deepseek-v4-flash":{"input":0.28,"cached_input":0.028,"output":0.42}}
LLM_PRICING=

# --- feature toggles ------------------------------------------------------
# Switch individual instructions in the prompts on and off. The registry —
# names, defaults and descriptions — lives in app/features.py; this only
# overrides defaults for a deployment. GET /debug/features lists them, and a
# grading request can override per call (that is how you benchmark).
# An unknown key here stops the service at startup rather than doing nothing.
#   FEATURES={"solve_independently": false}
# reconstruct_first is the one that changes what runs: false drops stage 1 and
# sends the photograph straight to the analysis stage.
#   FEATURES={"reconstruct_first": false}
#
# The deep_think_* trio sends {"thinking":{"type":"enabled"}} for one stage,
# merged OVER LLM_EXTRA_BODY / LLM_VISION_EXTRA_BODY below. Read those first:
# if a stage has no EXTRA_BODY the provider's own default already applies and
# switching the toggle on may change nothing. It is deliberately meaningful for
# stage 1, where the recommended config disables thinking outright.
#   FEATURES={"deep_think_analysis": true}
FEATURES=

# --- grading --------------------------------------------------------------
GRADING_SELF_CONSISTENCY=1    # >1 grades N times and takes the median score
GRADING_BATCH_LIMIT=20

# --- debug toolkit (see docs/DEBUG_TOOLKIT.md) ----------------------------
# Never enable these in production.  The app refuses to enable them when
# APP_ENV=prod unless DEBUG_ALLOW_IN_PROD=true is also set.
DEBUG_ENABLED=true
DEBUG_TOKEN=local-dev-token
DEBUG_ALLOW_IN_PROD=false
DEBUG_RECORD_TRACES=true
DEBUG_TRACE_LIMIT=100
